APP_NAME=tunnix
PORT=4310
DATABASE_URL=./tunnix.db

# JWT Secrets (change these in production!)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
TUNNEL_GRANT_SECRET=change_me_tunnel_grant_secret_min_32_chars
INTERNAL_GATEWAY_SECRET=change_me_internal_gateway_secret_here

# CORS
CORS_ORIGIN=http://localhost:5310

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@tunnix.local

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_BYPASS_IN_DEV=true

# Gateway
GATEWAY_PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_WS_URL=ws://localhost:9000
WILDCARD_BASE_DOMAIN=localhost

# Tunnel config
TUNNEL_GRANT_TTL_SECONDS=1800
TUNNEL_HEARTBEAT_TIMEOUT_SECONDS=120
TUNNEL_MAX_PER_USER=10
DEFAULT_USER_MAX_TUNNELS=3
DEFAULT_USER_MAX_SUBDOMAINS=3
RANDOM_SUBDOMAIN_LENGTH=8
SUBDOMAIN_PATTERN=^[a-z0-9]([a-z0-9-]*[a-z0-9])?$
DEV_TUNNEL_PATH_PREFIX=/dev-tunnel

# Auth debug (NEVER enable in production)
AUTH_DEBUG_LOG_OTP=true
